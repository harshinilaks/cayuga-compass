      "origins_destinations": "Downtown Ithaca, Cornell, airport, some state parks and trailheads",
      "fares": {
        "adult": 1.50,
        "senior_or_disability": 0.75,
        "age_17_and_under": 0,
        "daily_cap": 3.00,
        "passes": {"1_day": 3.00, "weekly": 17.50, "monthly": 45.00},
